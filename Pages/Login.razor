@page "/login"
@layout AuthLayout
@using System.Text.RegularExpressions
@using Social.Core.Models.Database
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Sign in - Social</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <img src="favicon.svg" alt="" class="auth-logo" />
        <MudText Typo="Typo.h4" Class="brand-title mt-3">Social</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @(_activeTab == 0 ? "Welcome back! Sign in to continue." : "Create your account in seconds.")
        </MudText>
    </div>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 mt-6">
        <MudTabs @bind-ActivePanelIndex="_activeTab" MinimumTabWidth="0" Rounded="true" ApplyEffectsToContainer="true"
                 TabPanelsClass="pt-6" Elevation="0">
            <MudTabPanel Text="Sign in">
                <div @onkeydown="@(e => OnEnter(e, SignIn))">
                <MudForm @ref="_loginForm" @bind-IsValid="_loginValid">
                    <MudTextField Immediate="true" @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email"
                                  Required="true" RequiredError="Email is required." Validation="@(new Func<string, string?>(ValidateEmail))"
                                  autocomplete="email" Class="mb-4" />
                    <MudTextField Immediate="true" @bind-Value="_password" Label="Password" Variant="Variant.Outlined"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                  OnAdornmentClick="() => _showPassword = !_showPassword" AdornmentAriaLabel="Show password"
                                  Required="true" RequiredError="Password is required." autocomplete="current-password" />
                </MudForm>
                </div>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           Class="mt-6 auth-submit" Disabled="_isLoading" OnClick="SignIn">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Sign in
                </MudButton>
            </MudTabPanel>

            <MudTabPanel Text="Sign up">
                <div @onkeydown="@(e => OnEnter(e, SignUp))">
                <MudForm @ref="_registerForm" @bind-IsValid="_registerValid">
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudTextField Immediate="true" @bind-Value="_vorname" Label="First name" Variant="Variant.Outlined"
                                          Required="true" RequiredError="Required." autocomplete="given-name" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField Immediate="true" @bind-Value="_nachname" Label="Last name" Variant="Variant.Outlined"
                                          Required="true" RequiredError="Required." autocomplete="family-name" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Immediate="true" Value="_username" ValueChanged="@((string v) => _username = (v ?? "").Trim().ToLowerInvariant())" Label="Username" Variant="Variant.Outlined"
                                          Adornment="Adornment.Start" AdornmentText="@("@")"
                                          HelperText="3–30 characters: a–z, 0–9, . and _"
                                          Required="true" RequiredError="Username is required." Validation="@(new Func<string, string?>(ValidateUsername))"
                                          autocomplete="username" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Immediate="true" @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email"
                                          Required="true" RequiredError="Email is required." Validation="@(new Func<string, string?>(ValidateEmail))"
                                          autocomplete="email" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Immediate="true" @bind-Value="_password" Label="Password" Variant="Variant.Outlined"
                                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                          OnAdornmentClick="() => _showPassword = !_showPassword" AdornmentAriaLabel="Show password"
                                          HelperText="At least 8 characters"
                                          Required="true" RequiredError="Password is required." Validation="@(new Func<string, string?>(ValidatePassword))"
                                          autocomplete="new-password" />
                        </MudItem>
                    </MudGrid>
                </MudForm>
                </div>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           Class="mt-6 auth-submit" Disabled="_isLoading" OnClick="SignUp">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Create account
                </MudButton>
            </MudTabPanel>
        </MudTabs>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@_errorMessage</MudAlert>
        }
        @if (!string.IsNullOrEmpty(_infoMessage))
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-4">@_infoMessage</MudAlert>
        }
    </MudPaper>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private MudForm _loginForm = null!;
    private MudForm _registerForm = null!;
    private bool _loginValid;
    private bool _registerValid;
    private int _activeTab;

    private string _email = "";
    private string _password = "";
    private string _username = "";
    private string _vorname = "";
    private string _nachname = "";
    private bool _showPassword;

    private bool _isLoading;
    private string _errorMessage = "";
    private string _infoMessage = "";

    private static readonly Regex UsernameRegex = new("^[a-z0-9._]{3,30}$");
    private static readonly Regex EmailRegex = new(@"^[^@\s]+@[^@\s]+\.[^@\s]+$");

    private static string? ValidateEmail(string value) =>
        string.IsNullOrEmpty(value) || EmailRegex.IsMatch(value) ? null : "Please enter a valid email address.";

    private static string? ValidateUsername(string value) =>
        string.IsNullOrEmpty(value) || UsernameRegex.IsMatch(value) ? null : "3–30 characters: a–z, 0–9, . and _";

    private static string? ValidatePassword(string value) =>
        string.IsNullOrEmpty(value) || value.Length >= 8 ? null : "At least 8 characters.";

    private async Task OnEnter(KeyboardEventArgs e, Func<Task> action)
    {
        if (e.Key == "Enter") await action();
    }

    private async Task SignIn()
    {
        await _loginForm.ValidateAsync();
        if (!_loginForm.IsValid || _isLoading) return;

        _isLoading = true;
        _errorMessage = _infoMessage = "";

        var result = await AuthService.Login(_email.Trim(), _password);
        _isLoading = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo(GetSafeReturnUrl(), replace: true);
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Sign in failed.";
        }
    }

    private async Task SignUp()
    {
        await _registerForm.ValidateAsync();
        if (!_registerForm.IsValid || _isLoading) return;

        _isLoading = true;
        _errorMessage = _infoMessage = "";

        try
        {
            var taken = await AuthService.IsUsernameTaken(_username);
            if (taken is { IsSuccess: true, Data: true })
            {
                _errorMessage = "This username is already taken.";
                return;
            }

            var profile = new User { Username = _username, Vorname = _vorname.Trim(), Nachname = _nachname.Trim() };
            var result = await AuthService.Register(_email.Trim(), _password, profile);

            if (!result.IsSuccess)
            {
                _errorMessage = result.ErrorMessage ?? "Sign up failed.";
            }
            else if (string.IsNullOrEmpty(result.Data?.AccessToken))
            {
                // Supabase verlangt eine E-Mail-Bestätigung, bevor eine Session entsteht
                _infoMessage = "Almost done! Check your inbox and confirm your email, then sign in.";
                _password = "";
                _activeTab = 0;
            }
            else
            {
                Navigation.NavigateTo(GetSafeReturnUrl(), replace: true);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Nur relative Pfade innerhalb der App zulassen (kein Open Redirect)
    private string GetSafeReturnUrl() =>
        string.IsNullOrEmpty(ReturnUrl) || ReturnUrl.Contains("://") || ReturnUrl.StartsWith("//") || ReturnUrl.StartsWith("login")
            ? ""
            : ReturnUrl;
}
