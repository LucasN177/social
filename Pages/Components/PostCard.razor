@using System.Text.RegularExpressions
@inject IPostService PostService
@inject IUserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudPaper Elevation="0" Outlined="true" Class="mb-4" Style="border-radius: 16px; overflow: hidden">
    <div class="post-header">
        <a href="@ProfileUrl(Post.User)"><UserAvatar User="Post.User" Size="40" /></a>
        <div class="post-meta">
            <a href="@ProfileUrl(Post.User)" class="post-author">
                @AuthorName(Post.User)
                @if (Post.User.IsVerified)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Color="Color.Primary" Class="ml-1" Style="font-size: 16px" />
                }
            </a>
            <div class="post-sub">
                <span title="@Post.CreatedAt.ToString("g")">@TimeAgo(Post.CreatedAt)</span>
                @if (!string.IsNullOrEmpty(Post.Location))
                {
                    <span> · <MudIcon Icon="@Icons.Material.Outlined.Place" Style="font-size: 14px; vertical-align: -2px" /> @Post.Location</span>
                }
            </div>
        </div>
        <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Post options">
            <MudMenuItem Icon="@Icons.Material.Outlined.Link" OnClick="CopyLink">Copy link</MudMenuItem>
            @if (PostService.IsOwnPost(Post))
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="DeletePost">Delete</MudMenuItem>
            }
        </MudMenu>
    </div>

    @if (Post.IsVideo && Post.ImageUrls.Count > 0)
    {
        <div class="post-media post-media--video">
            <video src="@Post.ImageUrls[0]" controls playsinline loop muted preload="metadata"></video>
        </div>
    }
    else if (Post.ImageUrls.Count == 1)
    {
        <div class="post-media" @ondblclick="LikeFromDoubleClick">
            <img src="@Post.ImageUrls[0]" alt="Photo by @AuthorName(Post.User)" loading="lazy" />
        </div>
    }
    else if (Post.ImageUrls.Count > 1)
    {
        <div class="post-media" @ondblclick="LikeFromDoubleClick">
            <MudCarousel TData="object" Class="post-carousel" ShowArrows="true" ShowBullets="true" AutoCycle="false" EnableSwipeGesture="true">
                @foreach (var imageUrl in Post.ImageUrls)
                {
                    <MudCarouselItem>
                        <img src="@imageUrl" alt="Photo by @AuthorName(Post.User)" loading="lazy" />
                    </MudCarouselItem>
                }
            </MudCarousel>
        </div>
    }

    <div class="post-body">
        <div class="post-actions">
            <MudIconButton Icon="@(Post.IsLiked ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                           Color="@(Post.IsLiked ? Color.Error : Color.Default)" OnClick="ToggleLike"
                           Class="@(_likePulse ? "like-pulse" : null)" aria-label="@(Post.IsLiked ? "Unlike" : "Like")" />
            <MudIconButton Icon="@Icons.Material.Outlined.ChatBubbleOutline" OnClick="ToggleComments" aria-label="Comments" />
            <MudIconButton Icon="@Icons.Material.Outlined.Share" OnClick="CopyLink" aria-label="Copy link" />
            <MudSpacer />
            <MudIconButton Icon="@(Post.IsBookmarked ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                           Color="@(Post.IsBookmarked ? Color.Primary : Color.Default)" OnClick="ToggleBookmark"
                           aria-label="@(Post.IsBookmarked ? "Remove from saved" : "Save")" />
        </div>

        <div class="post-likes">@Post.LikesCount.ToString("N0") @(Post.LikesCount == 1 ? "like" : "likes")</div>

        @if (!string.IsNullOrWhiteSpace(Post.Content))
        {
            <div class="post-content">
                <a href="@ProfileUrl(Post.User)" class="post-author-inline">@(Post.User.Username ?? AuthorName(Post.User))</a>
                @foreach (var part in SplitHashtags(Post.Content))
                {
                    if (part.IsTag)
                    {
                        <a class="post-hashtag" href="@($"tags/{Uri.EscapeDataString(part.Text[1..].ToLowerInvariant())}")">@part.Text</a>
                    }
                    else
                    {
                        @part.Text
                    }
                }
            </div>
        }

        @if (Post.CommentsCount > 0 && !_showComments)
        {
            <button class="post-link" @onclick="ToggleComments">
                View @(Post.CommentsCount == 1 ? "1 comment" : $"all {Post.CommentsCount} comments")
            </button>
        }

        @if (_showComments)
        {
            <div class="post-comments">
                @if (_comments is null)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                }
                else
                {
                    @foreach (var comment in _comments)
                    {
                        <div class="post-comment">
                            <a href="@ProfileUrl(comment.User)"><UserAvatar User="comment.User" Size="28" /></a>
                            <div class="flex-grow-1">
                                <span><a href="@ProfileUrl(comment.User)" class="post-author-inline">@(comment.User.Username ?? AuthorName(comment.User))</a> @comment.Content</span>
                                <div class="post-sub">@TimeAgo(comment.CreatedAt)</div>
                            </div>
                            @if (PostService.IsOwnComment(comment) || PostService.IsOwnPost(Post))
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="() => DeleteComment(comment)" aria-label="Delete comment" />
                            }
                        </div>
                    }
                }

                <div class="post-comment-input" @onkeydown="OnCommentKeyDown">
                    <UserAvatar User="_currentUser" Size="28" />
                    <MudTextField T="string" @bind-Value="_newComment" Immediate="true" Placeholder="Add a comment…"
                                  Variant="Variant.Text" Underline="false" MaxLength="2000" Class="flex-grow-1 mt-0" Disabled="_sendingComment" />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="AddComment"
                               Disabled="@(string.IsNullOrWhiteSpace(_newComment) || _sendingComment)">Post</MudButton>
                </div>
            </div>
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public Post Post { get; set; } = null!;
    [Parameter] public bool ShowCommentsInitially { get; set; }
    [Parameter] public EventCallback<Post> OnDeleted { get; set; }

    private static readonly Regex HashtagRegex = new(@"(#\w{1,50})", RegexOptions.Compiled);

    private bool _showComments;
    private List<Comment>? _comments;
    private string _newComment = "";
    private bool _sendingComment;
    private bool _likePulse;
    private User? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        if (ShowCommentsInitially)
            await ToggleComments();
    }

    private async Task ToggleLike()
    {
        _likePulse = !Post.IsLiked;
        var result = await PostService.ToggleLikeAsync(Post);
        if (!result.IsSuccess) Snackbar.Add("That didn't work. Please try again.", Severity.Error);
    }

    private async Task LikeFromDoubleClick()
    {
        if (!Post.IsLiked) await ToggleLike();
    }

    private async Task ToggleBookmark()
    {
        var result = await PostService.ToggleBookmarkAsync(Post);
        if (!result.IsSuccess)
            Snackbar.Add("That didn't work. Please try again.", Severity.Error);
        else if (Post.IsBookmarked)
            Snackbar.Add("Saved to your profile", Severity.Normal);
    }

    private async Task ToggleComments()
    {
        _showComments = !_showComments;
        if (_showComments)
        {
            _currentUser ??= await UserService.GetCurrentUserAsync();
            _comments ??= await PostService.GetCommentsAsync(Post.Id);
        }
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(_newComment) || _sendingComment) return;

        _sendingComment = true;
        var result = await PostService.AddCommentAsync(Post, _newComment);
        _sendingComment = false;

        if (result is { IsSuccess: true, Data: not null })
        {
            (_comments ??= new List<Comment>()).Add(result.Data);
            _newComment = "";
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Your comment could not be posted.", Severity.Error);
        }
    }

    private async Task OnCommentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await AddComment();
    }

    private async Task DeleteComment(Comment comment)
    {
        var result = await PostService.DeleteCommentAsync(Post, comment);
        if (result.IsSuccess)
            _comments?.Remove(comment);
        else
            Snackbar.Add("The comment could not be deleted.", Severity.Error);
    }

    private async Task DeletePost()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete post?", "This can't be undone. Likes, comments and photos will be removed too.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        var result = await PostService.DeletePostAsync(Post);
        if (result.IsSuccess)
        {
            Snackbar.Add("Post deleted", Severity.Normal);
            await OnDeleted.InvokeAsync(Post);
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "The post could not be deleted.", Severity.Error);
        }
    }

    private async Task CopyLink()
    {
        var url = Navigation.ToAbsoluteUri($"p/{Post.Id}").ToString();
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
        Snackbar.Add("Link copied", Severity.Normal);
    }

    private static string AuthorName(User user) =>
        !string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName : user.Username ?? "Unknown";

    private static string ProfileUrl(User user) =>
        string.IsNullOrEmpty(user.Username) ? "profile" : $"u/{user.Username}";

    private static IEnumerable<(string Text, bool IsTag)> SplitHashtags(string content) =>
        HashtagRegex.Split(content).Where(p => p.Length > 0).Select(p => (p, p.StartsWith('#') && HashtagRegex.IsMatch(p)));

    internal static string TimeAgo(DateTime dateTime)
    {
        var span = DateTime.Now - dateTime;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d";
        return dateTime.ToString(dateTime.Year == DateTime.Now.Year ? "d MMM" : "d MMM yyyy");
    }
}
