@* Text und Ort eines eigenen Posts ändern. Bilder/Videos bleiben unverändert. *@
@inject IPostService PostService

<MudDialog ContentClass="pt-2">
    <DialogContent>
        <MudTextField T="string" @bind-Value="_content" Immediate="true" Label="@L["Caption"]" Placeholder="@L["Write a caption… use #hashtags"]"
                      Variant="Variant.Outlined" Lines="5" MaxLength="IPostService.MaxContentLength"
                      Counter="IPostService.MaxContentLength" Disabled="_saving" AutoFocus="true" />

        @if (!Post.IsVideo)
        {
            <MudTextField T="string" @bind-Value="_location" Label="@L["Location"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Place" MaxLength="100" Class="mt-4"
                          Disabled="_saving" />
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@L[_errorMessage]</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(_saving || !HasChanges)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @L["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public Post Post { get; set; } = null!;

    private string _content = "";
    private string _location = "";
    private bool _saving;
    private string _errorMessage = "";

    private bool HasChanges =>
        (_content ?? "").Trim() != Post.Content || (_location ?? "").Trim() != Post.Location;

    protected override void OnInitialized()
    {
        _content = Post.Content;
        _location = Post.Location;
    }

    private async Task Save()
    {
        _saving = true;
        _errorMessage = "";
        var result = await PostService.UpdatePostAsync(Post, _content ?? "", _location ?? "");
        _saving = false;

        if (result.IsSuccess)
            MudDialog.Close(DialogResult.Ok(Post));
        else
            _errorMessage = result.ErrorMessage ?? "Your changes could not be saved.";
    }

    private void Cancel() => MudDialog.Cancel();
}
