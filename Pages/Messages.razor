@page "/messages"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IMessageService MessageService
@inject ActivityService Activity
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>@L["Messages"] - Social</PageTitle>

<div style="max-width: 640px; margin: 0 auto">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h5">@L["Messages"]</MudText>
        <div class="d-flex flex-wrap gap-1">
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.GroupAdd" OnClick="CreateGroup">@L["New group"]</MudButton>
            <MudButton Href="search" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Edit">@L["New message"]</MudButton>
        </div>
    </div>

    <MudPaper Elevation="0" Outlined="true" Style="border-radius: 16px; overflow: hidden">
        @if (_conversations is null)
        {
            @for (var i = 0; i < 4; i++)
            {
                <div class="d-flex align-center gap-3 pa-3">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="52px" Height="52px" />
                    <div class="flex-grow-1">
                        <MudSkeleton Width="40%" />
                        <MudSkeleton Width="70%" />
                    </div>
                </div>
            }
        }
        else if (_conversations.Count == 0)
        {
            <div class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Outlined.Forum" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="mt-2">@L["No messages yet"]</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Open someone's profile and tap “Message” to start a chat."]</MudText>
                <MudButton Href="search" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                           StartIcon="@Icons.Material.Outlined.PersonSearch">@L["Find people"]</MudButton>
            </div>
        }
        else
        {
            @foreach (var conversation in _conversations)
            {
                <a href="@($"messages/{conversation.Id}")" class="conversation @(conversation.UnreadCount > 0 ? "conversation--unread" : null)" @key="conversation.Id">
                    <UserAvatar User="conversation.AvatarUser" Size="52" />
                    <div class="conversation-text">
                        <div class="conversation-name">
                            @conversation.Name
                            @if (conversation.IsGroup)
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Group" Style="font-size: 16px; vertical-align: -3px" Class="ml-1 mud-text-secondary" />
                            }
                        </div>
                        <div class="conversation-preview">@Preview(conversation)</div>
                    </div>
                    <div class="conversation-meta">
                        <span>@PostCard.TimeAgo(conversation.LastMessageAt)</span>
                        @if (conversation.UnreadCount > 0)
                        {
                            <span class="conversation-badge">@conversation.UnreadCount</span>
                        }
                    </div>
                </a>
            }
        }
    </MudPaper>
</div>

@code {
    private List<Conversation>? _conversations;

    protected override async Task OnInitializedAsync()
    {
        _conversations = await MessageService.GetConversationsAsync();
        await Activity.RefreshAsync();
    }

    private static string Preview(Conversation conversation)
    {
        if (!conversation.HasMessages)
            return conversation.IsGroup ? Loc.L["{0} members · say hi 👋", conversation.MemberCount].Value : "";

        var prefix = conversation.LastMessageIsMine ? Loc.L["You: "].Value
            : conversation.IsGroup && !string.IsNullOrEmpty(conversation.LastSenderName) ? $"{conversation.LastSenderName}: "
            : "";
        var text = conversation.LastMessageIsDeleted ? Loc.L["Message deleted"].Value
            : conversation.LastMessageIsImage && string.IsNullOrWhiteSpace(conversation.LastMessage) ? Loc.L["📷 Photo"].Value
            : conversation.LastMessageIsImage ? $"📷 {conversation.LastMessage}"
            : conversation.LastMessage;
        return prefix + text;
    }

    private async Task CreateGroup()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<GroupDialog> { { x => x.Mode, GroupDialogMode.Create } };
        var dialog = await DialogService.ShowAsync<GroupDialog>(L["New group"].Value, parameters, options);
        if (await dialog.Result is { Canceled: false, Data: long id })
            Navigation.NavigateTo($"messages/{id}");
    }
}
