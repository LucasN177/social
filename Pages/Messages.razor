@page "/messages"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Messages - Social</PageTitle>

@* Platzhalter bis Phase 5 (Direktnachrichten mit Realtime) *@
<div style="max-width: 640px; margin: 0 auto">
    <MudText Typo="Typo.h5" Class="mb-4">Messages</MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center" Style="border-radius: 16px">
        <MudIcon Icon="@Icons.Material.Outlined.Forum" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h6" Class="mt-2">Direct messages are coming soon</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Soon you'll be able to chat privately with people you follow.
        </MudText>
        <div class="d-flex justify-center flex-wrap gap-2 mt-4">
            <MudButton Href="" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Home">Back to feed</MudButton>
            <MudButton Href="search" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PersonSearch">Find people</MudButton>
        </div>
    </MudPaper>
</div>
