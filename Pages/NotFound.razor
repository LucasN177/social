@page "/not-found"
@layout MainLayout

<PageTitle>Page not found - Social</PageTitle>

<div style="max-width: 640px; margin: 0 auto">
    <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center" Style="border-radius: 16px">
        <MudText Typo="Typo.h3" Class="brand-title">404</MudText>
        <MudText Typo="Typo.h6" Class="mt-2">This page doesn't exist</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">The link may be broken or the page may have been removed.</MudText>
        <div class="d-flex justify-center flex-wrap gap-2 mt-4">
            <MudButton Href="" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Home">Back to feed</MudButton>
            <MudButton Href="search" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Search">Search</MudButton>
        </div>
    </MudPaper>
</div>
