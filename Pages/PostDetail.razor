@page "/p/{Id:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IPostService PostService
@inject NavigationManager Navigation

<PageTitle>@(_post is null ? "Post" : $"Post by {_post.User.DisplayName}") - Social</PageTitle>

<div style="max-width: 640px; margin: 0 auto">
    <div class="d-flex align-center mb-2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" aria-label="Back" />
        <MudText Typo="Typo.h6" Class="ml-2">Post</MudText>
    </div>

    @if (_loading)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="border-radius: 16px">
            <div class="d-flex align-center gap-3 mb-3">
                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                <MudSkeleton Width="40%" />
            </div>
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="360px" />
        </MudPaper>
    }
    else if (_post is null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center" Style="border-radius: 16px">
            <MudIcon Icon="@Icons.Material.Outlined.HideImage" Size="Size.Large" Class="mud-text-secondary" />
            <MudText Typo="Typo.h6" Class="mt-2">Post not available</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">It may have been deleted.</MudText>
            <MudButton Href="" Variant="Variant.Text" Color="Color.Primary" Class="mt-4">Back to home</MudButton>
        </MudPaper>
    }
    else
    {
        <PostCard @key="_post.Id" Post="_post" ShowCommentsInitially="true" OnDeleted="@(_ => Navigation.NavigateTo("", replace: true))" />
    }
</div>

@code {
    [Parameter] public long Id { get; set; }

    private Post? _post;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _post = await PostService.GetPostAsync(Id);
        _loading = false;
    }

    [Inject] private IJSRuntime JS { get; set; } = null!;

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");
}
