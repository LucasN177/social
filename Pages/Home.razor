@page "/"
@page "/fyp"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject IUserService UserService
@inject IPostService PostService

<PageTitle>Home - Social</PageTitle>

<MudGrid>
    <MudItem xs="12" md="8">
        <StoriesComponent />

        <MudToggleGroup T="bool" Value="_explore" ValueChanged="SwitchFeed" Color="Color.Primary" Size="Size.Small"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Class="mb-4">
            <MudToggleItem Value="false" Text="Following" />
            <MudToggleItem Value="true" Text="Explore" />
        </MudToggleGroup>

        @if (_posts is null)
        {
            @for (var i = 0; i < 2; i++)
            {
                <MudPaper Elevation="0" Outlined="true" Class="mb-4 pa-4" Style="border-radius: 16px">
                    <div class="d-flex align-center gap-3 mb-3">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                        <MudSkeleton Width="40%" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" />
                    <MudSkeleton Width="70%" Class="mt-3" />
                </MudPaper>
            }
        }
        else if (_posts.Count == 0 && !_explore)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center" Style="border-radius: 16px">
                <MudIcon Icon="@Icons.Material.Outlined.Diversity3" Size="Size.Large" Class="mud-text-secondary" />
                <MudText Typo="Typo.h6" Class="mt-2">Your feed is empty</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Follow people to see their posts here, or share your own.</MudText>
                <div class="d-flex justify-center flex-wrap gap-2 mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SwitchFeed(true)"
                               StartIcon="@Icons.Material.Outlined.Explore">Explore posts</MudButton>
                    <MudButton Href="search" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PersonSearch">Find people</MudButton>
                </div>
            </MudPaper>
        }
        else if (_posts.Count == 0)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center" Style="border-radius: 16px">
                <MudIcon Icon="@Icons.Material.Outlined.PhotoCamera" Size="Size.Large" Class="mud-text-secondary" />
                <MudText Typo="Typo.h6" Class="mt-2">No posts yet</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Be the first to share something.</MudText>
                <MudButton Href="create" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                           StartIcon="@Icons.Material.Filled.Add">Create post</MudButton>
            </MudPaper>
        }
        else
        {
            @foreach (var post in _posts)
            {
                <PostCard @key="post.Id" Post="post" OnDeleted="RemovePost" />
            }

            @if (_hasMore)
            {
                <div class="d-flex justify-center my-4">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadMore" Disabled="_loadingMore">
                        @if (_loadingMore)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Load more
                    </MudButton>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary my-6">You're all caught up ✨</MudText>
            }
        }
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4" Style="border-radius: 16px">
            @if (_currentUser is null)
            {
                <div class="d-flex align-center gap-3">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="56px" Height="56px" />
                    <div class="flex-grow-1">
                        <MudSkeleton Width="60%" />
                        <MudSkeleton Width="40%" />
                    </div>
                </div>
            }
            else
            {
                <a href="profile" class="d-flex align-center gap-3 mb-4" style="color: inherit; text-decoration: none">
                    <UserAvatar User="_currentUser" Size="56" />
                    <div style="min-width: 0">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@_currentUser.DisplayName</MudText>
                        @if (!string.IsNullOrEmpty(_currentUser.Username))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@("@" + _currentUser.Username)</MudText>
                        }
                    </div>
                </a>

                <div class="d-flex justify-space-between text-center mb-4">
                    <div><MudText Typo="Typo.h6">@_currentUser.PostsCount.ToString("N0")</MudText><MudText Typo="Typo.caption">Posts</MudText></div>
                    <div><MudText Typo="Typo.h6">@_currentUser.FollowersCount.ToString("N0")</MudText><MudText Typo="Typo.caption">Followers</MudText></div>
                    <div><MudText Typo="Typo.h6">@_currentUser.FollowingCount.ToString("N0")</MudText><MudText Typo="Typo.caption">Following</MudText></div>
                </div>

                <MudButton Href="create" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Add">
                    Create post
                </MudButton>
            }
        </MudPaper>

        @if (_suggestedUsers is { Count: > 0 })
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4" Style="border-radius: 16px">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Suggestions for you</MudText>
                @foreach (var user in _suggestedUsers)
                {
                    @* Vorschläge sind per Definition noch nicht gefolgt *@
                    <UserListItem @key="user.Id" User="user" IsFollowing="false" />
                }
                <MudButton Href="search" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-1">See more</MudButton>
            </MudPaper>
        }

        @if (PopularTags.Count > 0)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="border-radius: 16px">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">Popular in your feed</MudText>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var (tag, count) in PopularTags)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                 Href="@($"tags/{Uri.EscapeDataString(tag)}")">#@tag · @count</MudChip>
                    }
                </div>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private List<Post>? _posts;
    private User? _currentUser;
    private List<User>? _suggestedUsers;
    private int _page;
    private bool _hasMore;
    private bool _loadingMore;
    // false = "Following" (eigene + gefolgte Accounts), true = "Explore" (alle Posts)
    private bool _explore;

    private List<(string Tag, int Count)> PopularTags =>
        (_posts ?? new List<Post>())
            .SelectMany(p => p.Tags)
            .GroupBy(t => t)
            .Select(g => (g.Key, g.Count()))
            .OrderByDescending(t => t.Item2)
            .Take(8)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        PostService.PostCreated += OnPostCreated;
        PostService.PostDeleted += OnPostDeleted;
        UserService.ProfileChanged += OnProfileChanged;
        UserService.FollowChanged += OnFollowChanged;

        await Task.WhenAll(LoadFirstPage(), LoadCurrentUser(), LoadSuggestedUsers());
    }

    private Task<List<Post>> LoadPage(int page) =>
        _explore ? PostService.GetFeedAsync(page) : PostService.GetHomeFeedAsync(page);

    private async Task SwitchFeed(bool explore)
    {
        if (_explore == explore) return;
        _explore = explore;
        _posts = null;
        await LoadFirstPage();
    }

    private async Task LoadFirstPage()
    {
        _page = 0;
        var posts = await LoadPage(0);
        _hasMore = posts.Count == IPostService.PageSize;
        _posts = posts;
    }

    private async Task LoadMore()
    {
        _loadingMore = true;
        var posts = await LoadPage(_page + 1);
        _page++;
        _hasMore = posts.Count == IPostService.PageSize;
        // Doppelte vermeiden, falls zwischendurch neue Posts dazugekommen sind
        var known = _posts!.Select(p => p.Id).ToHashSet();
        _posts!.AddRange(posts.Where(p => !known.Contains(p.Id)));
        _loadingMore = false;
    }

    private async Task LoadCurrentUser() => _currentUser = await UserService.GetCurrentUserAsync();

    private async Task LoadSuggestedUsers() => _suggestedUsers = await UserService.GetSuggestedUsersAsync();

    private void RemovePost(Post post) => _posts?.RemoveAll(p => p.Id == post.Id);

    private void OnPostCreated(long _) => InvokeAsync(async () =>
    {
        await Task.WhenAll(LoadFirstPage(), LoadCurrentUser());
        StateHasChanged();
    });

    private void OnPostDeleted(long id) => InvokeAsync(async () =>
    {
        _posts?.RemoveAll(p => p.Id == id);
        await LoadCurrentUser();
        StateHasChanged();
    });

    private void OnProfileChanged(User user) => InvokeAsync(() =>
    {
        _currentUser = user;
        StateHasChanged();
    });

    // Following-Feed und eigene Zähler hängen davon ab, wem man folgt
    private void OnFollowChanged(string userId, bool following) => InvokeAsync(async () =>
    {
        var reloadFeed = _explore ? Task.CompletedTask : LoadFirstPage();
        await Task.WhenAll(reloadFeed, LoadCurrentUser());
        StateHasChanged();
    });

    public void Dispose()
    {
        PostService.PostCreated -= OnPostCreated;
        PostService.PostDeleted -= OnPostDeleted;
        UserService.ProfileChanged -= OnProfileChanged;
        UserService.FollowChanged -= OnFollowChanged;
    }
}
