@inherits LayoutComponentBase
@implements IDisposable
@inject IThemeService ThemeService
@inject IAuthService AuthService
@inject NavigationManager Nav

<MudLayout>
    <MudAppBar Elevation="1" Fixed="true" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.AddBox"
                       Href="create" Color="Color.Primary" Style="margin-right: 10px"/>

        <MudStack Row="false" Spacing="0">
            <MudText Typo="Typo.h5" Class="mr-6 font-weight-bold brand-title" Style="margin-bottom: 0">
                Social
            </MudText>
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="margin-top: 0">by Lucas Nagelsmann</MudText>
            </MudHidden>
        </MudStack>

        <MudSpacer />

        <MudIconButton Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@ThemeService.ToggleTheme" />

        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.Settings" Href="settings">Settings</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Sign out</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudMainContent Class="pb-16">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pt-4">
            @Body
        </MudContainer>
    </MudMainContent>

    <MudAppBar Bottom="true" Fixed="true" Dense="true" Elevation="1">
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Home" Href="" Color="@GetColor("")" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.VideoLibrary" Href="reels" Color="@GetColor("reels")" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Send" Href="messages" Color="@GetColor("messages")" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Search" Href="search" Color="@GetColor("search")" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Href="profile" Color="@GetColor("profile")" />
        <MudSpacer />
    </MudAppBar>
</MudLayout>

@code
{
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    // Relative Pfade, damit die App auch unter /social/ (GitHub Pages) funktioniert
    private Color GetColor(string href)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        var isHome = href == "" && current is "" or "fyp";
        return isHome || (href != "" && current == href) ? Color.Primary : Color.Default;
    }

    private async Task Logout()
    {
        var result = await AuthService.Logout();
        // Ohne Server-Antwort steckt die Session noch im Supabase-Client: per Reload sauber neu starten
        Nav.NavigateTo("login", forceLoad: !result.IsSuccess, replace: true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
