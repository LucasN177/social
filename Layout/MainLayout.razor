@inherits LayoutComponentBase
@implements IDisposable
@inject IThemeService ThemeService
@inject IAuthService AuthService
@inject ActivityService Activity
@inject NavigationManager Nav

<MudLayout>
    <MudAppBar Elevation="1" Fixed="true" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.AddBox"
                       Href="create" Color="Color.Primary" Style="margin-right: 10px"/>

        <MudStack Row="false" Spacing="0">
            <MudText Typo="Typo.h5" Class="mr-6 font-weight-bold brand-title" Style="margin-bottom: 0">
                Social
            </MudText>
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="margin-top: 0">by Lucas Nagelsmann</MudText>
            </MudHidden>
        </MudStack>

        <MudSpacer />

        <MudBadge Content="@BadgeText(Activity.UnreadNotifications)" Visible="@(Activity.UnreadNotifications > 0)"
                  Color="Color.Error" Overlap="true" Bordered="true">
            <MudIconButton Icon="@Icons.Material.Outlined.FavoriteBorder" Href="notifications" Color="@GetColor("notifications", Color.Inherit)"
                           aria-label="@($"Notifications ({Activity.UnreadNotifications} unread)")" />
        </MudBadge>

        <MudIconButton Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@ThemeService.ToggleTheme" />

        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.Settings" Href="settings">Settings</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Sign out</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudMainContent Class="pb-16">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pt-4">
            <OfflineBanner />
            @* Unerwartete Fehler betreffen nur die Seite, nicht die ganze App (zurücksetzen per Navigation) *@
            <AppErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center" Style="border-radius: 16px">
                        <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" Color="Color.Error" />
                        <MudText Typo="Typo.h6" Class="mt-2">Something went wrong</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">This page couldn't be shown. Please try again.</MudText>
                        <div class="d-flex justify-center flex-wrap gap-2 mt-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _errorBoundary?.Recover()"
                                       StartIcon="@Icons.Material.Filled.Refresh">Try again</MudButton>
                            <MudButton Href="./" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Home">Home</MudButton>
                        </div>
                    </MudPaper>
                </ErrorContent>
            </AppErrorBoundary>
        </MudContainer>
    </MudMainContent>

    <MudAppBar Bottom="true" Fixed="true" Dense="true" Elevation="1">
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Home" Href="./" Color="@GetColor("")" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.VideoLibrary" Href="reels" Color="@GetColor("reels")" />
        <MudSpacer />
        <MudBadge Content="@BadgeText(Activity.UnreadMessages)" Visible="@(Activity.UnreadMessages > 0)"
                  Color="Color.Error" Overlap="true" Bordered="true">
            <MudIconButton Icon="@Icons.Material.Filled.Send" Href="messages" Color="@GetColor("messages")"
                           aria-label="@($"Messages ({Activity.UnreadMessages} unread)")" />
        </MudBadge>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Search" Href="search" Color="@GetColor("search")" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Href="profile" Color="@GetColor("profile")" />
        <MudSpacer />
    </MudAppBar>
</MudLayout>

@code
{
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Activity.Changed += OnActivityChanged;
        // Badges nur für eingeloggte User (MainLayout rendert z. B. auch die 404-Seite)
        if (AuthService.CurrentUser is not null) Activity.Start();
    }

    private AppErrorBoundary? _errorBoundary;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Nach einem Fehler beim Seitenwechsel wieder normal rendern
        _errorBoundary?.Recover();
        StateHasChanged();
    }

    private void OnActivityChanged() => InvokeAsync(StateHasChanged);

    private static string BadgeText(int count) => count > 99 ? "99+" : count.ToString();

    // Relative Pfade, damit die App auch unter /social/ (GitHub Pages) funktioniert
    private Color GetColor(string href, Color inactive = Color.Default)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        var isHome = href == "" && current is "" or "fyp";
        var isActive = isHome || (href != "" && (current == href || current.StartsWith(href + "/")));
        return isActive ? Color.Primary : inactive;
    }

    private async Task Logout()
    {
        Activity.Stop();
        var result = await AuthService.Logout();
        // Ohne Server-Antwort steckt die Session noch im Supabase-Client: per Reload sauber neu starten
        Nav.NavigateTo("login", forceLoad: !result.IsSuccess, replace: true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Activity.Changed -= OnActivityChanged;
    }
}
